HOST=127.0.0.1
PORT=4173
PUBLIC_ORIGIN=http://127.0.0.1:4173
DATA_DIR=./data
# Set both to enable live AI explanations. No credentials are needed for rule mode.
VULTR_INFERENCE_KEY=
VULTR_INFERENCE_MODEL=
